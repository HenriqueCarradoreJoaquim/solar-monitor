# --- SOLARMAN OpenAPI (peça appId/appSecret ao suporte da SOLARMAN) ---
SOLARMAN_BASE_URL=https://globalapi.solarmanpv.com
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
SOLARMAN_EMAIL=
# Use UMA das duas (preferível o hash). Gerar hash: echo -n 'suasenha' | sha256sum
SOLARMAN_PASSWORD_SHA256=
# SOLARMAN_PASSWORD=

# Opcional: se vazio, usa a primeira usina da conta (rode `npm run discover` para ver o ID)
SOLARMAN_STATION_ID=

# --- Coletor ---
# Cron de coleta (padrão: a cada 10 min)
COLLECT_CRON=*/10 * * * *
TZ=America/Sao_Paulo

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
# Token simples para proteger a API (use o mesmo no app React Native)
API_TOKEN=troque-por-um-token-longo
DB_PATH=./data/solar.db

# --- Telegram (grátis) ---
# 1) No Telegram, fale com @BotFather, envie /newbot e copie o token
# 2) Com `npm start` rodando, mande /id para o seu bot e copie o número para TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Horário do relatório diário (padrão: 20:00)
REPORT_CRON=0 20 * * *

# --- Comentário por IA (opcional; sem isso o relatório sai normal, só sem a frase da IA) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Local da usina (para a previsão do tempo) — padrão: Criciúma/SC ---
LATITUDE=-28.677
LONGITUDE=-49.37
# Previsão de geração enviada de manhã (padrão: 07:00)
FORECAST_CRON=0 7 * * *
# Alertas no Telegram (true/false)
ALERTS_ENABLED=true
